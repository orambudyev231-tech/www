PORT=3001

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nav_site
MYSQL_USER=nav_site
MYSQL_PASSWORD=请改成你的数据库密码
MYSQL_CONNECTION_LIMIT=10
# 旧版本 server/data/nav.db 存在时，首次启动自动导入到 MySQL；导入后可改成 0
MYSQL_MIGRATE_SQLITE=1

# 数据库自动备份到 GitHub 私有仓库（可选）
# 服务器需要安装 git 和 mysqldump
BACKUP_REPO=https://<token>@github.com/<用户名>/nav-db-backup.git
BACKUP_INTERVAL_MIN=60
