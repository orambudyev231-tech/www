PORT=3001

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nav_site
MYSQL_USER=nav_site
MYSQL_PASSWORD=请改成你的数据库密码
MYSQL_CONNECTION_LIMIT=10
# 旧版本 server/data/nav.db 存在时，首次启动自动导入到 MySQL；导入后可改成 0
MYSQL_MIGRATE_SQLITE=1

# 数据库自动备份到 GitHub 仓库（可选）
# 服务器需要安装 git 和 mysqldump；token 需要对目标仓库有写权限
BACKUP_REPO=https://<token>@github.com/orambudyev231-tech/www.git
# 每天固定整点备份（本地时间），5 = 每天凌晨 5 点；设置后忽略 BACKUP_INTERVAL_MIN
BACKUP_DAILY_AT=5
# 或者按间隔备份（分钟），仅在未设置 BACKUP_DAILY_AT 时生效
#BACKUP_INTERVAL_MIN=60
