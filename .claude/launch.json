{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server (Express API + dist)",
      "runtimeExecutable": "C:/Users/Administrator/nodejs/node.exe",
      "runtimeArgs": ["server/src/index.js"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "client (Vite dev)",
      "runtimeExecutable": "C:/Users/Administrator/nodejs/node.exe",
